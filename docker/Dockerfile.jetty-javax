# Jetty 9.4 (javax) with the range WAR deployed at /range.
# The official image keeps the deployable base at /var/lib/jetty, not JETTY_HOME.
ARG BASE_IMAGE=jetty:9.4.58-jdk8-eclipse-temurin
FROM ${BASE_IMAGE}
ARG ARTIFACT=range-war-javax-*.war
COPY --chown=jetty:jetty ${ARTIFACT} /var/lib/jetty/webapps/range.war
